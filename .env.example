# ================= MarketPulse — Environment Variables =================
# Copy to backend/.env for local development, or paste these into the
# Render (backend) / Vercel (frontend) dashboards when deploying.

# ------------------------------ AI -----------------------------------
# Required for ALL AI features (theses, assistant, recap, news analysis, vision).
# Free key: https://aistudio.google.com/apikey
# MULTI-KEY: paste several keys comma-separated to multiply the free daily
# quota - the client rotates keys automatically and parks exhausted ones.
# GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=your_gemini_api_key_here
# Model override (default gemini-3.6-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------- Market data (all optional) -----------------
# Fallback chain: NSE (keyless) -> Yahoo (keyless) -> Stooq (keyless)
#                 -> Twelve Data -> Finnhub -> Alpha Vantage
# The core app runs keyless; these add fallback depth only.
# MULTI-KEY: comma-separated keys rotate automatically (each free key has
# its own daily quota, so N keys = N x the budget).
# Get free keys:
#   https://twelvedata.com/  (800/day per key)
#   https://finnhub.io/     (60/min per key)
#   https://www.alphavantage.co/ (25/day per key)
# TWELVEDATA_API_KEY=key1,key2
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=key1,key2
ALPHAVANTAGE_API_KEY=

# ------------------------------ Server --------------------------------
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Backend host/port
HOST=0.0.0.0
PORT=8000

# ------------------------------ Frontend ------------------------------
# Vite env (frontend/.env or Vercel dashboard) — where the frontend finds the backend
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------ Demo ----------------------------------
# Force demo mode regardless of provider health (true/false)
FORCE_DEMO_MODE=false
# --- PRISM tracing (optional) ---
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
